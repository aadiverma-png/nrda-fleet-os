<?xml version="1.0"?>
<model>
  <name>nrds_lidar_proxy</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>NRDA</name></author>
  <description>What the AMR lidars see of the warehouse: the floor-level collision boxes as plain box visuals (visibility flag 2), 1 cm inset so they stay hidden inside the detailed mesh. The 24 MB mesh itself is hidden from the lidars (flag 1), which lets 40 GPU lidars run in real time on a laptop GPU. Generated by scripts/make_lidar_proxy.py.</description>
</model>
