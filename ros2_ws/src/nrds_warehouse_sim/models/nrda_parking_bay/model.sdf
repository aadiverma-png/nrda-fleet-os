<?xml version="1.0"?>
<!-- Floor paint for one AMR-01 parking bay (1.4 x 1.0 m). Visual only. +x = the side the robot drives out of. -->
<sdf version="1.9">
  <model name="nrda_parking_bay">
    <static>true</static>
    <link name="paint">
      <visual name="left"><pose>0 0.5 0.002 0 0 0</pose><geometry><box><size>1.4 0.05 0.002</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <visual name="right"><pose>0 -0.5 0.002 0 0 0</pose><geometry><box><size>1.4 0.05 0.002</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <visual name="back"><pose>-0.7 0 0.002 0 0 0</pose><geometry><box><size>0.05 1.05 0.002</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <visual name="nose"><pose>0.62 0 0.002 0 0 0</pose><geometry><box><size>0.12 0.4 0.002</size></box></geometry>
        <material><ambient>0.15 0.45 0.9 1</ambient><diffuse>0.15 0.45 0.9 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
